# env files (contains secrets - never commit)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build diagnostics written to the repo root by ad-hoc type-check runs
tsc-full.log
tsc-full.txt

# this project uses pnpm (pnpm-lock.yaml) — ignore other package managers' lockfiles
package-lock.json
yarn.lock
