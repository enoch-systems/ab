# Copy this file to .env.local and fill in the values for your project:
#   cp .env.example .env.local
# .env.local is git-ignored and is never committed.

# ── Cloudinary ──────────────────────────────────────────────────────────────
# Dashboard → Settings → API keys / Upload.
# Cloud name drives every image + video URL (lib/cloudinary/).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Server-only — never expose these to the browser (no NEXT_PUBLIC_ prefix).
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend — optional until the domain is verified.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ArcBest <notifications@your-domain.com>

# Supabase (Dashboard -> Project Settings -> API)
# Anon key is browser-safe (RLS still enforces access). Service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
